[alias]
	# My hold overs from svn days
	st = status -s
	ci = commit
	co = checkout

[apply]
	# Detect whitespace errors when applying a patch.
	whitespace = fix

[branch]
	# controls whether new branches should be set up to be rebased upon git pull
	autosetuprebase = always

	# Sorts branches by committer date (see https://blog.gitbutler.com/git-tips-2-new-stuff-in-git/)
	sort = -committerdate

[branchless "revsets.alias"]
	this = stack()

[core]
	# Use custom `.gitignore`
	excludesfile = ~/.dotfiles/files/config/git/ignore

	# Treat spaces before tabs and all kinds of trailing whitespace as an error.
	# [default] trailing-space: looks for spaces at the end of a line
	# [default] space-before-tab: looks for spaces before tabs at the beginning of a line
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space

	# Make `git rebase` safer on macOS.
	# More info: http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/
	trustctime = false

	# Normalize Unicode filenames on macOS so composed/decomposed forms are treated as the same file.
	# Without this, filenames with accented characters can appear as untracked after checkout.
	precomposeunicode = true

	# `git branch` is difficult to use with less (see https://stackoverflow.com/a/49862151).
	# This makes interactions that require paging a bit more reasonable.
	pager = less -FRX

	# Improve Git monorepo performance with a file system monitor
	# (https://github.blog/2022-06-29-improve-git-monorepo-performance-with-a-file-system-monitor/)
	fsmonitor = true
	untrackedcache = true

	# Replaces CRLF to LF if they get introduced
	autocrlf = input

[diff]
	# Detect copies as well as renames.
	renames = copy

	# Better diffing algorithm for tracking better / more context.
	algorithm = histogram

	# Highlight moved code in a distinct color from added/deleted lines, making refactors easier to review.
	colorMoved = default

	# Use Kaleidoscope for diffs when invoking `git difftool`
	tool = ksdiff

[diff "bin"]
	# Use `hexdump` to diff binary files.
	textconv = hexdump -v -C

[difftool]
	prompt = false
	trustExitCode = true

[difftool "ksdiff"]
	cmd = ksdiff --partial-changeset --relative-path \"$MERGED\" -- \"$LOCAL\" \"$REMOTE\"

[fetch]
	# Automatically remove local refs to remote branches that have been deleted on the remote.
	prune = true

	# Automatically remove local refs to remote tags that no longer exist on the remote.
	pruneTags = true

[help]
	# Prompt before auto-correcting a mistyped git command, instead of running it immediately.
	autocorrect = prompt

[init]
	templatedir = ~/.dotfiles/files/config/git/template
	defaultBranch = develop

[log]
	# Display dates as 2023-05-25 13:54:51 instead of Thu May 25 13:54:51 2023
	date = iso

	# Show abbreviated commit hashes in log output.
	abbrevCommit = true

[merge]
	# Shows old, new, and ancestor when highlighting a conflict
	conflictstyle = zdiff3

	# Use Kaleidoscope for diffs when invoking `git mergetool`
	tool = ksdiff

[mergetool]
	prompt = false

[mergetool "ksdiff"]
	cmd = ksdiff --merge --output \"$MERGED\" --base \"$BASE\" -- \"$LOCAL\" --snapshot \"$REMOTE\" --snapshot
	trustExitCode = true

[push]
	# Pushes the current branch to the remote, even if it is not tracked.
	default = current

	# Automatically set the upstream tracking branch on first push, eliminating the need for -u origin HEAD.
	autoSetupRemote = true

[pull]
	# Only allow fastforward merges https://docs.gitlab.com/ee/user/project/merge_requests/methods/#fast-forward-merge
	ff = only

[rebase]
	# Squashes `--fixup` when rebasing.
	autosquash = true

	# Automatically stashes changes before running a rebase.
	autostash = true

	# When rebasing, automatically update any local branches that point to commits being rebased (useful for stacked PRs).
	updateRefs = true

[rerere]
	enabled = true

[user]
	name = Enrique Osuna
	email = 12620+feosuna1@users.noreply.github.com

[tag]
	# Sort tags by version number in descending order, so the latest release appears first.
	sort = -version:refname

[column]
	# Display output from commands like `git branch` and `git tag` in columns when the terminal is wide enough.
	ui = auto

[url "git@github.com:"]
	pushInsteadOf = "https://github.com/"
