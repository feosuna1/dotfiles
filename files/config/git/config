[alias]
	# My hold overs from svn days
	st = status -s
	ci = commit
	co = checkout

[apply]
	# Detect whitespace errors when applying a patch.
	whitespace = fix

[branch]
	# controls whether new branches should be set up to be rebased upon git pull
	autosetuprebase = always

	# Sorts branches by committer date (see https://blog.gitbutler.com/git-tips-2-new-stuff-in-git/)
	sort = -committerdate

[branchless "revsets.alias"]
	this = stack()

[core]
	# Use custom `.gitignore`
	excludesfile = ~/.dotfiles/files/config/git/ignore

	# Treat spaces before tabs and all kinds of trailing whitespace as an error.
	# [default] trailing-space: looks for spaces at the end of a line
	# [default] space-before-tab: looks for spaces before tabs at the beginning of a line
	whitespace = space-before-tab,-indent-with-non-tab,trailing-space

	# Make `git rebase` safer on macOS.
	# More info: http://www.git-tower.com/blog/make-git-rebase-safe-on-osx/
	trustctime = false

	# Prevent showing files whose names contain non-ASCII symbols as unversioned.
	# http://michael-kuehnel.de/git/2014/11/21/git-mac-osx-and-german-umlaute.html
	precomposeunicode = false

	## `git branch` is difficult to use with less (see https://stackoverflow.com/a/49862151).
	## This makes interactions that require paging a bit more reasonable.
	## pager = less -FRX
	## pager = "diff-so-fancy | less --tabs=4 -RFX" # nicer diffs
	pager = delta

	# Improve Git monorepo performance with a file system monitor
	# (https://github.blog/2022-06-29-improve-git-monorepo-performance-with-a-file-system-monitor/)
	fsmonitor = true
	untrackedcache = true

	# Replaces CRLF to LF if they get introduced
	autocrlf = input

[delta]
    navigate = true  # use n and N to move between diff sections
    side-by-side = true
	line-numbers = true

[diff]
	# Detect copies as well as renames.
	renames = copy

	# Better diffing algorithm for tracking better / more context.
	algorithm = histogram

[diff "bin"]
	# Use `hexdump` to diff binary files.
	textconv = hexdump -v -C

[difftool]
	prompt = false
	trustExitCode = true

[init]
	templatedir = ~/.dotfiles/files/config/git/template
	defaultBranch = develop

[interactive]
	diffFilter = delta --color-only

[log]
	# Display dates as 2023-05-25 13:54:51 instead of Thu May 25 13:54:51 2023
	date = iso

[merge]
	# Shows old, new, and ancestor when highlighting a conflict
	conflictstyle = zdiff3

[mergetool]
	prompt = false

[push]
	# Pushes the current branch to the remote, even if it is not tracked.
	default = current

[pull]
	# Only allow fastforward merges https://docs.gitlab.com/ee/user/project/merge_requests/methods/#fast-forward-merge
	ff = only

[rebase]
	# Squashes `--fixup` when rebasing.
	autosquash = true

	# Automatically stashes changes before running a rebase.
	autostash = true

[rerere]
	enabled = true

[user]
	name = Enrique Osuna
	email = 12620+feosuna1@users.noreply.github.com

[url "git@github.com:"]
	pushInsteadOf = "https://github.com/"

[bash]
	showInformativeStatus = true
	showDirtyState = true
	showUntrackedFiles = true
