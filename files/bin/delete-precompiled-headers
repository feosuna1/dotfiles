#!/usr/bin/env sh
if ! command -v fd 2>&1 >/dev/null
then
    find ~/Library/Developer/Xcode/DerivedData -type d -name 'PrecompiledHeaders' -execdir rm -rf {} \;
    find ~/Library/Developer/Xcode/DerivedData -type d -name 'SwiftExplicitPrecompiledModules' -execdir rm -rf {} \;
else
    fd -td -F 'PrecompiledHeaders' ~/Library/Developer/Xcode/DerivedData -x rm -fr
    fd -td -F 'SwiftExplicitPrecompiledModules' ~/Library/Developer/Xcode/DerivedData -x rm -fr
fi
