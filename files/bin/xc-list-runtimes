#!/bin/bash
set -o errexit # Exit if any individual command fails and isn't handled
set -o nounset # Exit if unset variables are used
set -o pipefail # Exit if any command in a pipeline fails and isn't handled

exec xcrun simctl runtime list -j | jq '
def runtimes: .[]
    | select(.deletable)
    | { version, build, identifier, runtimeIdentifier, lastUsedAt }
    ;

def by_runtime_identifier: .
    | group_by(.runtimeIdentifier)
    | map({ key: .[0].runtimeIdentifier | capture("SimRuntime\\.(?<a>.+?)-") | .a, value: . | sort_by(.build) | reverse})
    | from_entries
    ;

def by_verison: .
    | group_by(.version)
    | map({ key: .[0].version, value: by_runtime_identifier })
    | from_entries
    ;

def to_dictionary: . | by_verison;

[runtimes] | to_dictionary
'
