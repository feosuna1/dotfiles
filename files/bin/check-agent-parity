#!/bin/bash

# Warn when the reviewer-agent wrappers in files/claude/agents/*.md and
# files/codex/agents/*.toml have drifted apart. Warn-only: drift should be
# surfaced at install time, not fail the install.
#
# Checks per pair: both wrappers exist, descriptions are byte-identical, both
# reference the same shared review guide (which must exist), and the model
# tiers agree per the mapping documented in files/agents/AGENTS.md
# (Claude sonnet <-> Codex effort "high", haiku <-> "medium").

CLAUDE_AGENTS_DIR="$HOME/.dotfiles/files/claude/agents"
CODEX_AGENTS_DIR="$HOME/.dotfiles/files/codex/agents"

# Read one top-level key out of a Claude wrapper's YAML front matter. Missing
# keys come back empty rather than as the string "null".
claude_field() {
    yq --front-matter=extract --exit-status "$2 // \"\"" "$1"
}

# Read one top-level key out of a Codex wrapper's TOML.
codex_field() {
    yq --input-format=toml --output-format=yaml --exit-status "$2 // \"\"" "$1"
}

check_agent_parity() {
    local drift=0 file name

    if ! command -v yq > /dev/null 2>&1; then
        echo "Error: agent parity check requires yq (see Brewfile)." >&2
        return 1
    fi

    local claude_names codex_names
    claude_names=$(for file in "$CLAUDE_AGENTS_DIR"/*.md; do
        basename "$file" .md
    done | sort)
    codex_names=$(for file in "$CODEX_AGENTS_DIR"/*.toml; do
        basename "$file" .toml
    done | sort)

    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        echo "Warning: agent $name has a Claude wrapper but no Codex twin."
        drift=1
    done < <(comm -23 <(printf '%s\n' "$claude_names") <(printf '%s\n' "$codex_names"))
    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        echo "Warning: agent $name has a Codex wrapper but no Claude twin."
        drift=1
    done < <(comm -13 <(printf '%s\n' "$claude_names") <(printf '%s\n' "$codex_names"))

    while IFS= read -r name; do
        [[ -z "$name" ]] && continue
        local claude_file="$CLAUDE_AGENTS_DIR/$name.md"
        local codex_file="$CODEX_AGENTS_DIR/$name.toml"

        # A malformed wrapper would make every field read as empty, and two
        # empty fields compare equal — so report it instead of silently passing.
        if ! claude_field "$claude_file" . > /dev/null 2>&1; then
            echo "Warning: agent $name: Claude wrapper has malformed YAML front matter."
            drift=1
            continue
        fi
        if ! codex_field "$codex_file" . > /dev/null 2>&1; then
            echo "Warning: agent $name: Codex wrapper has malformed TOML."
            drift=1
            continue
        fi

        local claude_desc codex_desc
        claude_desc=$(claude_field "$claude_file" .description)
        codex_desc=$(codex_field "$codex_file" .description)
        if [[ "$claude_desc" != "$codex_desc" ]]; then
            echo "Warning: agent $name: descriptions differ between wrappers."
            drift=1
        fi

        local claude_model codex_effort expected_effort=""
        claude_model=$(claude_field "$claude_file" .model)
        codex_effort=$(codex_field "$codex_file" .model_reasoning_effort)
        case "$claude_model" in
            sonnet) expected_effort="high" ;;
            haiku) expected_effort="medium" ;;
            *)
                echo "Warning: agent $name: Claude model \"$claude_model\" is not a documented tier (see files/agents/AGENTS.md)."
                drift=1
                ;;
        esac
        if [[ -n "$expected_effort" && "$codex_effort" != "$expected_effort" ]]; then
            echo "Warning: agent $name: Claude model $claude_model pairs with Codex effort \"$expected_effort\", found \"$codex_effort\"."
            drift=1
        fi

        local claude_guide codex_guide
        claude_guide=$(sed -n 's/^@//p' "$claude_file")
        # shellcheck disable=SC2088 # literal pattern matched inside the prose, not a path
        codex_guide=$(codex_field "$codex_file" .developer_instructions |
            grep -o '~/\.dotfiles/files/agents/review/[a-z-]*\.md' | head -n 1 || true)
        if [[ "$claude_guide" != "$codex_guide" ]]; then
            echo "Warning: agent $name: wrappers reference different review guides (\"$claude_guide\" vs \"${codex_guide:-none}\")."
            drift=1
        fi
        if [[ -n "$claude_guide" && ! -f "${claude_guide/#\~/$HOME}" ]]; then
            echo "Warning: agent $name: review guide $claude_guide does not exist."
            drift=1
        fi
    done < <(comm -12 <(printf '%s\n' "$claude_names") <(printf '%s\n' "$codex_names"))

    if [[ "$drift" -eq 0 ]]; then
        echo "Claude and Codex reviewer agents are in parity."
    fi
    return 0
}

check_agent_parity
