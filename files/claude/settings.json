{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {},
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Bash(* --help *)",
      "Bash(* --version *)",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(date)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git status)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jj diff *)",
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj status)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(ps *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(uname *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whoami)"
    ],
    "ask": [
      "Bash(jj push *)",
      "Bash(jj git push *)"
    ],
    "deny": [
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(curl *)",
      "Bash(git clean *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git reset * --hard *)",
      "Bash(rm *)",
      "Edit(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/credentials/**)",
      "Edit(**/secrets/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/Desktop/**)",
      "Edit(~/Documents/**)",
      "Edit(~/Downloads/**)",
      "Edit(~/Library/**)",
      "Read(**/.env.*)",
      "Read(**/.env)",
      "Read(**/credentials/**)",
      "Read(**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/Desktop/**)",
      "Read(~/Documents/**)",
      "Read(~/Downloads/**)",
      "Read(~/Library/**)",
      "Write(**/.env.*)",
      "Write(**/.env)",
      "Write(**/credentials/**)",
      "Write(**/secrets/**)",
      "Write(~/.aws/**)",
      "Write(~/.ssh/**)",
      "Write(~/Desktop/**)",
      "Write(~/Documents/**)",
      "Write(~/Downloads/**)",
      "Write(~/Library/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "fish ~/.dotfiles/files/claude/statusline-command.fish"
  }
}
