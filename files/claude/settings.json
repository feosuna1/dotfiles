{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "awaySummaryEnabled": false,
  "effortLevel": "medium",
  "enabledPlugins": {},
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/files/claude/scripts/sort-settings.sh",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/files/claude/scripts/worktree-create.sh",
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "bash ~/.dotfiles/files/claude/scripts/worktree-remove.sh",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Bash(* --help *)",
      "Bash(* --version *)",
      "Bash(/Users/feo/.claude/skills/**/scripts/*)",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(cat *)",
      "Bash(cut *)",
      "Bash(date)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(file *)",
      "Bash(find *)",
      "Bash(gh pr view *)",
      "Bash(git branch *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git stash list)",
      "Bash(git status)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(jj diff *)",
      "Bash(jj log *)",
      "Bash(jj show *)",
      "Bash(jj status)",
      "Bash(jq *)",
      "Bash(ls *)",
      "Bash(ps *)",
      "Bash(pwd)",
      "Bash(rg *)",
      "Bash(sort *)",
      "Bash(stat *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(uname *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Skill(my-write-commit-message)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git reset * --hard *)",
      "Bash(jj git push *)",
      "Bash(jj push *)",
      "Bash(rm *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(git clean *)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/credentials/**)",
      "Edit(**/secrets/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.netrc)",
      "Edit(~/.ssh/**)",
      "Edit(~/Desktop/**)",
      "Edit(~/Documents/**)",
      "Edit(~/Downloads/**)",
      "Edit(~/Library/**)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/credentials/**)",
      "Read(**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.netrc)",
      "Read(~/.ssh/**)",
      "Read(~/Desktop/**)",
      "Read(~/Documents/**)"
    ]
  },
  "skipAutoPermissionPrompt": true,
  "statusLine": {
    "command": "fish ~/.dotfiles/files/claude/statusline-command.fish",
    "type": "command"
  },
  "theme": "auto",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "voiceEnabled": true
}
