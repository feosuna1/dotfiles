Match host github.com exec "vcs-email-matches '^(email1|email2)@'"
    IdentityFile ~/.ssh/personal/%h.ed25519.pub

Match host github.com !exec "vcs-email-matches '^(email1|email2)@'"
    IdentityFile ~/.ssh/work/%h.ed25519.pub

Host github.com
    User git
    IdentitiesOnly yes

Host *
